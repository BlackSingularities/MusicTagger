{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMusicTagger",
  "version": "1.0.0",
  "identifier": "com.blacksingularities.musictagger",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenMusicTagger",
        "width": 1320,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BlackSingularities",
    "category": "Music",
    "shortDescription": "Otwarty, inteligentny tagger muzyki",
    "longDescription": "OpenMusicTagger skanuje bibliotekę muzyczną, uzupełnia brakujące tagi, okładki i teksty utworów z czasami (LRC).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
